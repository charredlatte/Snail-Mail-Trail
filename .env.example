# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://snailmail:changeme@localhost:5432/snailmail
PORT=3000
HOST=0.0.0.0

# Comma-separated origins allowed to call the API from a browser.
# In production this is your real domain. No wildcards - cookies are involved.
CORS_ORIGIN=http://localhost:5173

# Set to "true" in production so session cookies require HTTPS.
COOKIE_SECURE=false

# Contact email sent to the geocoder (Nominatim asks for one). Import script only.
GEOCODER_CONTACT=you@example.com
